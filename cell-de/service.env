# Per-service config for the cell-de lambda (differential expression of
# user-selected single cells vs the rest of the strain). Sourced by ../aws/*.sh
# after ../aws/common.env. Any value can be overridden from the environment.

# Lambda + IAM
export FUNCTION_NAME="${FUNCTION_NAME:-cell-de}"
export ROLE_NAME="${ROLE_NAME:-cell-de-lambda-role}"
# A strain's cell-wise counts are ~0.45 GB in memory. The account caps Lambda at
# 3008 MB, so the cache keeps two strains (peak 1.8 GB in prod); with all three
# cached plus a load and a request in flight, local peak RSS was 2.5 GB.
export LAMBDA_MEMORY="${LAMBDA_MEMORY:-3008}"     # MB
export LAMBDA_TIMEOUT="${LAMBDA_TIMEOUT:-30}"     # seconds
export HANDLER="${HANDLER:-handler.lambda_handler}"

# Route exposed via the app CloudFront distribution.
export ROUTE="${ROUTE:-/cell-de}"

# One request per selection the user makes.
export THROTTLE_RATE="${THROTTLE_RATE:-5}"
export THROTTLE_BURST="${THROTTLE_BURST:-10}"

# Cell-wise artifacts built by build_cellwise.py, uploaded with
# ../aws/upload_matrices.sh cell-de.
export NEEDS_S3="${NEEDS_S3:-true}"
export MATRIX_BUCKET="${MATRIX_BUCKET:-biolab-cell-de-us-east-1}"
export MATRIX_PREFIX="${MATRIX_PREFIX:-cellwise}"
export BUCKET="${MATRIX_BUCKET}"
# The ~48 MB zip times out as a direct upload; stage it in BUCKET instead.
export CODE_VIA_S3="${CODE_VIA_S3:-true}"

export MATRIX_CACHE_MB="${MATRIX_CACHE_MB:-1024}"
# Loaded by the keep-warm ping (../aws/keep_warm.sh cell-de), not at cold start:
# fetching a strain from S3 at init passes Lambda's 10 s init limit, and a
# timed-out init is rerun inside the first request (25 s instead of 13 s).
export WARM_STRAINS="${WARM_STRAINS:-AX4}"

export LAMBDA_ENV="MATRIX_BUCKET=${MATRIX_BUCKET} MATRIX_PREFIX=${MATRIX_PREFIX} MATRIX_CACHE_MB=${MATRIX_CACHE_MB} WARM_STRAINS=${WARM_STRAINS}"
