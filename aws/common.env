# Shared AWS configuration for all lambda services. Sourced before each
# service's service.env. Every value can be overridden from the environment.

export AWS_REGION="${AWS_REGION:-us-east-1}"
export ACCOUNT_ID="${ACCOUNT_ID:-$(aws sts get-caller-identity --query Account --output text)}"
export PYTHON_VERSION="${PYTHON_VERSION:-3.12}"
export LAMBDA_RUNTIME="python${PYTHON_VERSION}"

# The app CloudFront distribution serving app.dictyexpress.org. Services are
# attached as same-origin routes (e.g. /find-similar, /go) on this distribution.
export CF_DISTRIBUTION_ID="${CF_DISTRIBUTION_ID:-E2QIIEU865FG98}"
