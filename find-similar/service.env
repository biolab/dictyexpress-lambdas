# Per-service config for the find-similar lambda. Sourced by ../aws/*.sh after
# ../aws/common.env. Any value can be overridden from the environment.

# Lambda + IAM
export FUNCTION_NAME="${FUNCTION_NAME:-fast-find-similar}"
export ROLE_NAME="${ROLE_NAME:-fast-find-similar-lambda-role}"
export LAMBDA_MEMORY="${LAMBDA_MEMORY:-1769}"     # MB (~1 full vCPU: faster numpy import + compute)
export LAMBDA_TIMEOUT="${LAMBDA_TIMEOUT:-30}"     # seconds
export HANDLER="${HANDLER:-handler.lambda_handler}"

# Route exposed via the app CloudFront distribution.
export ROUTE="${ROUTE:-/find-similar}"

# API Gateway throttle on the public endpoint (find-similar is ~1 req/click, so
# this caps abuse without affecting interactive use).
export THROTTLE_RATE="${THROTTLE_RATE:-20}"    # steady requests/sec
export THROTTLE_BURST="${THROTTLE_BURST:-40}"  # burst bucket size

# This service reads/writes an S3 bucket of precomputed matrices.
export NEEDS_S3="${NEEDS_S3:-true}"
export MATRIX_BUCKET="${MATRIX_BUCKET:-biolab-fast-find-similar-us-east-1}"
export MATRIX_PREFIX="${MATRIX_PREFIX:-matrices}"
# Generic bucket name the deploy scripts grant the role access to.
export BUCKET="${MATRIX_BUCKET}"

# Lambda environment variables (consumed by handler.py / core.py).
# FIND_SIMILAR_TOP_N=0 -> return all genes (the chosen full-fidelity behavior).
export MATRIX_CACHE_MB="${MATRIX_CACHE_MB:-256}"
export FIND_SIMILAR_TOP_N="${FIND_SIMILAR_TOP_N:-0}"
# Preloaded into the in-memory cache at cold start so the default dataset (the
# one every user lands on first) serves instantly. Empty to disable.
export PRELOAD_TIME_SERIES="${PRELOAD_TIME_SERIES:-627}"

# Space-separated KEY=VALUE pairs injected as Lambda env vars at deploy time.
export LAMBDA_ENV="MATRIX_BUCKET=${MATRIX_BUCKET} MATRIX_PREFIX=${MATRIX_PREFIX} MATRIX_CACHE_MB=${MATRIX_CACHE_MB} FIND_SIMILAR_TOP_N=${FIND_SIMILAR_TOP_N} PRELOAD_TIME_SERIES=${PRELOAD_TIME_SERIES}"
