# Per-service config for the GO enrichment lambda. Sourced by ../aws/*.sh after
# ../aws/common.env. Any value can be overridden from the environment.

export FUNCTION_NAME="${FUNCTION_NAME:-dicty-go}"
export ROLE_NAME="${ROLE_NAME:-dicty-go-lambda-role}"
export LAMBDA_MEMORY="${LAMBDA_MEMORY:-2048}"     # MB (loads ~24MB obo_obj + runs processor)
export LAMBDA_TIMEOUT="${LAMBDA_TIMEOUT:-60}"     # seconds
export HANDLER="${HANDLER:-handler.lambda_handler}"

# Route exposed via the app CloudFront distribution.
export ROUTE="${ROUTE:-/go}"

# API Gateway throttle on the public endpoint.
export THROTTLE_RATE="${THROTTLE_RATE:-20}"    # steady requests/sec
export THROTTLE_BURST="${THROTTLE_BURST:-40}"  # burst bucket size

# S3 bucket holding the precomputed gotea obo_obj/gaf_obj artifacts.
export NEEDS_S3="${NEEDS_S3:-true}"
export GO_BUCKET="${GO_BUCKET:-biolab-dicty-go-us-east-1}"
export GO_PREFIX="${GO_PREFIX:-go}"
# Generic bucket name the deploy scripts grant the role access to.
export BUCKET="${GO_BUCKET}"

# GO enrichment defaults (overridable per request).
export GO_PVAL_THRESHOLD="${GO_PVAL_THRESHOLD:-0.1}"
export GO_MIN_GENES="${GO_MIN_GENES:-1}"

# Space-separated KEY=VALUE pairs injected as Lambda env vars at deploy time.
export LAMBDA_ENV="GO_BUCKET=${GO_BUCKET} GO_PREFIX=${GO_PREFIX} GO_PVAL_THRESHOLD=${GO_PVAL_THRESHOLD} GO_MIN_GENES=${GO_MIN_GENES}"
